<script
  define:vars={{
    baseAfiche: ruta('/familia-zk/afiche'),
    redirecciones: {
      '#sucursales': ruta('/sucursales'),
      '#convenios': ruta('/convenios'),
      '#equipo': ruta('/equipo-clinico'),
    },
  }}
>
  /* Anclas de la v2 que ya no existen en Inicio: se redirigen a su página nueva.
     #nosotros y #membresias siguen siendo anclas válidas de esta página. */
  const destino = redirecciones[location.hash];
  if (destino) location.replace(destino);

  /* Popover «Agenda tu evaluación»: abre al click, cierra al click fuera o con Esc. */
  const agendaBtn = document.getElementById('zk-agenda-btn');
  const agendaPop = document.getElementById('zk-agenda-pop');
  const cerrarAgenda = () => {
    agendaPop?.setAttribute('hidden', '');
    agendaBtn?.setAttribute('aria-expanded', 'false');
  };
  agendaBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const abierto = !agendaPop?.hasAttribute('hidden');
    if (abierto) {
      cerrarAgenda();
    } else {
      agendaPop?.removeAttribute('hidden');
      agendaBtn.setAttribute('aria-expanded', 'true');
    }
  });
  document.addEventListener('click', (e) => {
    if (!agendaPop || agendaPop.hasAttribute('hidden')) return;
    if (!agendaPop.contains(e.target) && e.target !== agendaBtn) cerrarAgenda();
  });

  /* Selector de especialidades: cambia el panel sin recargar. */
  const filas = Array.from(document.querySelectorAll('[data-espec]'));
  const paneles = Array.from(document.querySelectorAll('[data-panel]'));
  /* En teléfono el panel queda apilado debajo del índice (ver inicio.css):
     tras elegir una especialidad hay que bajar hasta el panel, descontando
     el alto del header sticky (62px, fijado en chrome.css). matchMedia evita
     tocar el scroll de escritorio, donde índice y panel ya conviven. */
  const zkMovil = window.matchMedia('(max-width: 767px)');
  const verPanelActivo = () => {
    if (!zkMovil.matches) return;
    const panelActivo = paneles.find((p) => !p.hidden);
    if (!panelActivo) return;
    const y = panelActivo.getBoundingClientRect().top + window.scrollY - 62 - 12;
    window.scrollTo({ top: y, behavior: 'smooth' });
  };
  const seleccionar = (i) => {
    filas.forEach((f) => {
      const activa = Number(f.dataset.espec) === i;
      f.toggleAttribute('data-activa', activa);
      f.setAttribute('aria-selected', activa ? 'true' : 'false');
    });
    paneles.forEach((p) => {
      p.hidden = Number(p.dataset.panel) !== i;
    });
    verPanelActivo();
  };
  filas.forEach((f) => f.addEventListener('click', () => seleccionar(Number(f.dataset.espec))));
  document
    .querySelectorAll('[data-espec-idx]')
    .forEach((a) => a.addEventListener('click', () => seleccionar(Number(a.dataset.especIdx))));

  /* Modal del afiche: abre desde «Conoce ZK …»; cierra con Esc, click fuera o postMessage. */
  const modal = document.getElementById('zk-afiche');
  const marco = document.getElementById('zk-afiche-iframe');
  const cerrarAfiche = () => {
    modal?.setAttribute('hidden', '');
    if (marco) marco.src = '';
  };
  document.querySelectorAll('[data-afiche]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      if (marco) marco.src = baseAfiche + '?m=' + a.dataset.afiche + '&embed=1';
      modal?.removeAttribute('hidden');
    })
  );
  document.getElementById('zk-afiche-fondo')?.addEventListener('click', cerrarAfiche);
  document.getElementById('zk-afiche-caja')?.addEventListener('click', (e) => e.stopPropagation());
  window.addEventListener('message', (e) => {
    if (e.data === 'zk-close-afiche') cerrarAfiche();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    cerrarAfiche();
    cerrarAgenda();
  });
</script>

