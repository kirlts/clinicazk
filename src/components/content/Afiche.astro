---
/* Afiche de membresía — Afiche v3.dc.html. Folleto de dos caras (presentación +
   «Lo que incluye»), pensado para imprimirse en A4 y para verse embebido en el modal. */
import MembershipTag from './MembershipTag.astro';
import { AFICHES, COMO_USARLA, IMPORTANTE, VIGENCIA, condicionesDe } from '../../data/afiche';
import type { ClaveMembresia } from '../../data/membresias';
import { logoHorizontal } from '../../lib/imagenes';

interface Props {
  membership: ClaveMembresia;
}

const { membership } = Astro.props;
const d = AFICHES[membership];
const stages = d.stages.map((s, i) => ({ n: i + 1, ...s }));
const ruta = d.ruta.map((label, i) => ({ n: i + 1, label }));
const rutaTitulo = 'Tu ruta de cuidado en ' + stages.length + ' etapas';
const condiciones = condicionesDe(membership);
---

<div class="desk">
  <!-- ============ CARA A: presentación ============ -->
  <section class={`face m-${membership}`}>
    <button type="button" class="zk-volver-embed" data-volver>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="m12 19-7-7 7-7M5 12h14"></path></svg
      >Volver al sitio
    </button>

    <header class="zk-af-top" style="display:flex;justify-content:space-between;align-items:center">
      <img src={logoHorizontal.src} alt="Clínica ZK" style="height:38px" />
      <span
        class="zk-af-badge"
        style="display:inline-flex;align-items:center;gap:8px;padding:8px 16px 8px 13px;border:1.5px solid var(--m);border-radius:var(--radius-pill);color:var(--m);font-size:14px;font-weight:600;line-height:1"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M12 5.5c-1.5-1.3-3.2-1.8-4.8-1.3C4.6 5 3.5 7.5 4 10.2c.3 1.6 1 3.6 2 5.3.9 1.6 1.7 2.8 2.5 2.8.9 0 1-.9 1.5-.9s.6.9 1.5.9c.8 0 1.6-1.2 2.5-2.8"
          ></path><path d="m15.5 3 1 2.2 2.4.3-1.8 1.6.5 2.4-2.1-1.2-2.1 1.2.5-2.4-1.8-1.6 2.4-.3z"></path></svg
        >
        {d.name}
      </span>
    </header>

    <div class="zk-af-hero" style="margin-top:40px">
      <div style="font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--m);font-weight:600">
        Membresía anual
      </div>
      <h1 class="zk-af-h1" style="margin:12px 0 0;font-size:52px;line-height:1.02;font-weight:300;color:var(--text-heading)">
        {d.name}
      </h1>
      <p class="zk-af-tagline" style="margin:16px 0 0;font-size:22px;line-height:1.35;color:var(--m);max-width:560px">{d.tagline}</p>
    </div>

    <p class="zk-af-sub" style="margin:22px 0 0;font-size:16px;line-height:1.6;color:var(--text-body);max-width:600px">{d.sub}</p>

    <!-- tarjetita física + beneficios -->
    <div class="zk-af-beneficios" style="display:flex;gap:40px;align-items:center;margin-top:36px">
      <MembershipTag membership={membership} name={d.name} motto={d.tagMotto} size="sm" />
      <ul class="zk-af-beneficios-lista" style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:18px;flex:1">
        {
          d.beneficios.map((b) => (
            <li style="display:flex;gap:14px;align-items:flex-start">
              <span style="width:38px;height:38px;flex-shrink:0;border-radius:50%;background:var(--mtint);color:var(--m);display:inline-flex;align-items:center;justify-content:center">
                <svg
                  width="19"
                  height="19"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <div>
                <div style="font-size:16px;font-weight:600;color:var(--text-heading)">{b.title}</div>
                <div style="font-size:14px;color:var(--text-body);line-height:1.45">{b.desc}</div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ruta de cuidado -->
    <div class="zk-af-ruta" style="margin-top:auto;padding-top:34px">
      <div
        style="font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:var(--m);font-weight:600;text-align:center"
      >
        {rutaTitulo}
      </div>
      <div class="zk-af-ruta-fila" style="display:flex;align-items:flex-start;justify-content:space-between;margin-top:20px;position:relative">
        <div class="zk-af-ruta-linea" style="position:absolute;top:26px;left:9%;right:9%;border-top:2px dotted var(--border-strong);z-index:0"></div>
        {
          ruta.map((paso) => (
            <div class="zk-af-ruta-paso" style="display:flex;flex-direction:column;align-items:center;gap:10px;position:relative;z-index:1;flex:1;text-align:center;padding:0 6px">
              <span class="zk-af-ruta-num" style="width:52px;height:52px;border-radius:50%;background:var(--zk-white);border:2px solid var(--m);color:var(--m);display:inline-flex;align-items:center;justify-content:center;font-size:19px;font-weight:700">
                {paso.n}
              </span>
              <span class="zk-af-ruta-label" style="font-size:12.5px;line-height:1.35;color:var(--text-body)">{paso.label}</span>
            </div>
          ))
        }
      </div>
    </div>

    <footer
      class="zk-pie-impreso zk-af-pie"
      style="align-items:center;gap:18px;margin-top:32px;padding-top:22px;border-top:1px solid var(--border-subtle)"
    >
      <div
        style="width:64px;height:64px;flex-shrink:0;border:1.5px solid var(--border-strong);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--text-muted)"
      >
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
          ><rect width="5" height="5" x="3" y="3" rx="1"></rect><rect width="5" height="5" x="16" y="3" rx="1"
          ></rect><rect width="5" height="5" x="3" y="16" rx="1"></rect><path
            d="M21 16h-3a2 2 0 0 0-2 2v3M21 21v.01M12 7v3a2 2 0 0 1-2 2H7M3 12h.01M12 3h.01M12 16v.01M16 12h1M21 12v.01M12 21v-1"
          ></path></svg
        >
      </div>
      <div style="flex:1">
        <div style="font-size:15px;font-weight:600;color:var(--text-heading)">Escanea el QR y conoce más</div>
        <div style="display:inline-flex;align-items:center;gap:6px;font-size:14px;color:var(--text-body);margin-top:3px">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--m)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M20 10c0 4.4-8 12-8 12s-8-7.6-8-12a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"
            ></circle></svg
          >Disponible en Pucón y Los Ángeles
        </div>
      </div>
      <div style="font-size:15px;font-style:italic;color:var(--m);text-align:right;max-width:220px;line-height:1.3">
        {d.tagline}
      </div>
    </footer>
  </section>

  <!-- ============ CARA B: lo que incluye ============ -->
  <section class={`face m-${membership}`}>
    <header class="zk-pie-impreso zk-af-top" style="justify-content:space-between;align-items:center">
      <img src={logoHorizontal.src} alt="Clínica ZK" style="height:34px" />
      <span
        class="zk-af-badge"
        style="display:inline-flex;align-items:center;gap:8px;padding:7px 15px 7px 12px;border:1.5px solid var(--m);border-radius:var(--radius-pill);color:var(--m);font-size:13px;font-weight:600;line-height:1"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M12 5.5c-1.5-1.3-3.2-1.8-4.8-1.3C4.6 5 3.5 7.5 4 10.2c.3 1.6 1 3.6 2 5.3.9 1.6 1.7 2.8 2.5 2.8.9 0 1-.9 1.5-.9s.6.9 1.5.9c.8 0 1.6-1.2 2.5-2.8"
          ></path><path d="m15.5 3 1 2.2 2.4.3-1.8 1.6.5 2.4-2.1-1.2-2.1 1.2.5-2.4-1.8-1.6 2.4-.3z"></path></svg
        >
        {d.name}
      </span>
    </header>

    <div class="zk-af-h2" style="text-align:center;margin-top:20px">
      <h2 style="margin:0;font-size:30px;line-height:1.15;font-weight:300;color:var(--m)">
        Lo que incluye tu membresía {d.name}
      </h2>
    </div>

    <!-- ideal para ti si -->
    <div
      class="zk-af-ideal"
      style="margin-top:22px;background:var(--mtint);border-radius:var(--radius-lg);padding:22px 26px;display:flex;gap:20px;align-items:flex-start"
    >
      <span
        style="width:46px;height:46px;flex-shrink:0;border-radius:50%;background:var(--m);color:#fff;display:inline-flex;align-items:center;justify-content:center"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><circle cx="12" cy="8" r="5"></circle><path d="M20 21a8 8 0 0 0-16 0"></path></svg
        >
      </span>
      <div style="flex:1">
        <div style="font-size:17px;font-weight:700;color:var(--text-heading);margin-bottom:10px">Ideal para ti si…</div>
        <ul class="zk-af-ideal-lista" style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:8px 24px">
          {
            d.ideal.map((item) => (
              <li style="display:flex;gap:9px;font-size:13.5px;color:var(--text-body);line-height:1.4">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--m)"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  style="flex-shrink:0;margin-top:2px"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- timeline vertical de etapas -->
    <ol style="margin:24px 0 0;padding:0;list-style:none;flex:1;display:flex;flex-direction:column">
      {
        stages.map((stage) => (
          <li class="tl-item" style="display:flex;gap:16px">
            <div style="display:flex;flex-direction:column;align-items:center;flex-shrink:0">
              <span style="width:40px;height:40px;border-radius:50%;background:var(--m);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:16px;font-weight:700">
                {stage.n}
              </span>
              <span
                class="tl-line"
                style="flex:1;width:0;border-left:2px dotted var(--border-strong);min-height:14px;margin:4px 0"
              />
            </div>
            <div style="flex:1;padding-bottom:16px">
              <div style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--m);font-weight:600">
                Etapa {stage.n}
              </div>
              <div style="font-size:16px;font-weight:600;color:var(--text-heading);margin:2px 0 7px">{stage.title}</div>
              <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:5px">
                {stage.items.map((it) => (
                  <li style="font-size:13.5px;color:var(--text-body);line-height:1.5">{it}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- cómo comenzar + importante -->
    <div class="zk-af-doscol" style="display:grid;grid-template-columns:1.1fr 1fr;gap:20px;margin-top:8px">
      <div style="border:1px solid var(--border-subtle);border-radius:var(--radius-lg);padding:18px 20px">
        <div style="font-size:15px;font-weight:700;color:var(--text-heading);margin-bottom:10px">¿Cómo comenzar?</div>
        <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px">
          {
            COMO_USARLA.map((paso) => (
              <li style="display:flex;gap:9px;font-size:13px;color:var(--text-body);line-height:1.45">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--m)"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  style="flex-shrink:0;margin-top:2px"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {paso}
              </li>
            ))
          }
        </ul>
      </div>
      <div style="background:var(--surface-section);border-radius:var(--radius-lg);padding:18px 20px">
        <div style="font-size:15px;font-weight:700;color:var(--text-heading);margin-bottom:10px">
          Vigencia e información importante
        </div>
        <p style="margin:0;font-size:12.5px;color:var(--text-muted);line-height:1.5">{VIGENCIA}</p>
        {condiciones && <p style="margin:8px 0 0;font-size:12.5px;color:var(--text-muted);line-height:1.5">{condiciones}</p>}
        <p style="margin:8px 0 0;font-size:12.5px;color:var(--text-muted);line-height:1.5">{IMPORTANTE}</p>
      </div>
    </div>

    <footer
      class="zk-pie-impreso zk-af-pie"
      style="align-items:center;gap:18px;margin-top:22px;padding-top:20px;border-top:1px solid var(--border-subtle)"
    >
      <div
        style="width:58px;height:58px;flex-shrink:0;border:1.5px solid var(--border-strong);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--text-muted)"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
          ><rect width="5" height="5" x="3" y="3" rx="1"></rect><rect width="5" height="5" x="16" y="3" rx="1"
          ></rect><rect width="5" height="5" x="3" y="16" rx="1"></rect><path
            d="M21 16h-3a2 2 0 0 0-2 2v3M21 21v.01M12 7v3a2 2 0 0 1-2 2H7M3 12h.01M12 3h.01M12 16v.01M16 12h1M21 12v.01M12 21v-1"
          ></path></svg
        >
      </div>
      <div style="flex:1">
        <div style="font-size:14px;font-weight:600;color:var(--text-heading)">Escanea el QR y agenda tu evaluación</div>
        <div style="display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--text-body);margin-top:3px">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="var(--m)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M20 10c0 4.4-8 12-8 12s-8-7.6-8-12a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"
            ></circle></svg
          >Disponible en Pucón y Los Ángeles
        </div>
      </div>
      <img src={logoHorizontal.src} alt="Clínica ZK" style="height:28px" />
    </footer>
    <div>
      <div
        style="margin-top:26px;padding-top:22px;border-top:1px solid var(--border-subtle);display:flex;justify-content:center"
      >
        <button type="button" class="zk-volver" data-volver>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m12 19-7-7 7-7M5 12h14"></path></svg
          >Volver a Familia ZK
        </button>
      </div>
    </div>
  </section>
</div>
