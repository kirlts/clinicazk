---
/* Equipo clínico (/equipo-clinico) — Equipo clinico v3.dc.html.
   Dirección Clínica va destacada aparte; el resto en rejilla unida por hairlines,
   ordenada por disponibilidad de sedes. El filtro por sede es client-side. */
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import WhatsAppFab from '../components/site/WhatsAppFab.astro';
import { getImage } from 'astro:assets';
import { wa, GRAD_LA, GRAD_PU, type Sede } from '../data/contacto';
import { EQUIPO, FILTROS, ordenarSedes, rankSedes, type Profesional } from '../data/equipo';
import { retratos, isotipo } from '../lib/imagenes';

const BTN =
  'display: inline-flex; align-items: center; justify-content: center; text-align: center; gap: 8px; padding: 11px 16px; font-size: 13.5px; font-family: var(--font-sans); color: #fff; text-decoration: none; border: none; border-radius: var(--radius-md); cursor: pointer; box-shadow: 0 2px 10px rgba(47,63,66,.20), inset 0 0 0 1px rgba(255,255,255,.16); transition: filter .18s var(--ease-out), transform .18s var(--ease-out); background: ';
const TAG = 'font-size: 12.5px; padding: 3px 9px; border-radius: var(--radius-sm); white-space: nowrap; ';
const tagStyle = (s: Sede) =>
  TAG + (s === 'Pucón' ? 'background: #F3EEF6; color: #775A80;' : 'background: #E8F5F4; color: var(--zk-teal-700);');

/* Los retratos van como background-image: mantiene el encuadre del diseño (center 22% / 38%). */
const urlRetrato = async (archivo: string, ancho: number) =>
  (await getImage({ src: retratos[archivo], width: ancho, format: 'webp' })).src;

const ficha = async (d: Profesional) => {
  const sedesOrden = ordenarSedes(d.sedes);
  // Con agenda programada en Pucón, esa sede se comunica con su propia etiqueta y su
  // propio botón: no se repite el genérico.
  const regulares = d.agendaPucon ? sedesOrden.filter((s) => s !== 'Pucón') : sedesOrden;

  const tags: { label: string; style: string }[] = regulares.map((s) => ({ label: s, style: tagStyle(s) }));
  if (d.agendaPucon) {
    tags.push({
      label: 'En Pucón, consultar agenda',
      style: TAG + 'background: var(--surface-section); color: var(--text-muted);',
    });
  }

  const actions = regulares.map((s) => ({
    label: 'Consultar agenda en ' + s,
    href: wa(s, 'Hola, quisiera consultar por atención con ' + d.name + ' en Clínica ZK ' + s + '.'),
    style: BTN + (s === 'Pucón' ? GRAD_PU : GRAD_LA) + ';',
  }));
  if (d.agendaPucon) {
    actions.push({
      label: 'Consultar próxima fecha en Pucón',
      href: wa(
        'Pucón',
        'Hola, quisiera consultar por la próxima fecha disponible de atención de cirugía maxilofacial en Clínica ZK Pucón.'
      ),
      style: BTN + GRAD_PU + ';',
    });
  }

  return {
    name: d.name,
    area: d.area,
    bio: d.bio,
    sedes: sedesOrden,
    foto: await urlRetrato(d.foto, 320),
    alt: 'Retrato de ' + d.name + ', ' + d.area + ' en Clínica ZK.',
    tags,
    actions,
  };
};

const visible = await Promise.all(
  EQUIPO.filter((d) => !d.dir)
    .slice()
    .sort((a, b) => rankSedes(a) - rankSedes(b))
    .map(ficha)
);

const dirRaw = EQUIPO.find((d) => d.dir)!;
const direccion = {
  name: dirRaw.name,
  area: dirRaw.area,
  bio: dirRaw.bio,
  bioDir: dirRaw.bioDir,
  sedes: ordenarSedes(dirRaw.sedes),
  foto: await urlRetrato(dirRaw.foto, 480),
  alt: 'Retrato de ' + dirRaw.name + ', Dirección Clínica de Clínica ZK.',
  tags: ordenarSedes(dirRaw.sedes).map((s) => ({ label: s, style: tagStyle(s) })),
  actions: ordenarSedes(dirRaw.sedes).map((s) => ({
    label: 'Consultar agenda en ' + s,
    href: wa(s, 'Hola, quisiera consultar por atención con ' + dirRaw.name + ' en Clínica ZK ' + s + '.'),
    style: BTN + (s === 'Pucón' ? GRAD_PU : GRAD_LA) + ';',
  })),
};

/* El FAB deja elegir sucursal: el mensaje es el mismo para las dos. */
const MSG_FAB = 'Hola, visité la página web de Clínica ZK y quisiera realizar una consulta.';
const fabLa = wa('Los Ángeles', MSG_FAB);
const fabPu = wa('Pucón', MSG_FAB);
const totalInicial = visible.length + 1;
---

<Layout
  title="Equipo Clínico | Clínica ZK Pucón y Los Ángeles"
  description="Conoce a los profesionales y áreas de atención de Clínica ZK en Pucón y Los Ángeles."
>
  <div style="font-family: var(--font-sans); color: var(--text-body);">
    <SiteHeader active="Equipo" />

    <section style="position: relative; overflow: hidden; padding: 104px 24px 0;">
      <div
        aria-hidden="true"
        class="zk-marca-hero"
        style={`position: absolute; top: -130px; right: -100px; width: 600px; height: 613px; background: url(${isotipo.src}) center / contain no-repeat; opacity: .055; pointer-events: none;`}
      >
      </div>
      <div style="position: relative; max-width: var(--container-max); margin: 0 auto;">
        <div style="text-align: center; padding-bottom: 64px; border-bottom: 1px solid var(--border-subtle);">
          <h1
            style="font-size: clamp(34px, 3.8vw, 58px); font-weight: var(--fw-light); line-height: 1.08; color: var(--text-heading); margin: 0; text-wrap: pretty;"
          >
            Profesionales que acompañan tu cuidado.
          </h1>
          <p style="font-size: 16px; line-height: var(--lh-body); margin: 28px auto 0; max-width: 1000px; text-wrap: pretty;">
            Nuestro equipo clínico reúne profesionales de distintas áreas de la odontología, coordinados para orientar,
            diagnosticar y acompañar cada proceso de acuerdo con las necesidades de cada paciente.
          </p>
          <p style="font-size: 16px; line-height: var(--lh-body); margin: 18px auto 0; max-width: 1000px; text-wrap: pretty;">
            En Pucón y Los Ángeles trabajamos para que puedas identificar con claridad qué atención necesitas, quién
            puede ayudarte y cómo continuar tu cuidado.
          </p>
        </div>

        <div style="margin-top: 44px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
          {
            FILTROS.map((f, i) => (
              <button type="button" data-filtro={f} class="zk-chip" data-activo={i === 0 ? '' : undefined}>
                {f}
              </button>
            ))
          }
          <span
            id="zk-conteo"
            style="margin-left: auto; font-size: 14px; color: var(--text-muted); font-variant-numeric: tabular-nums;"
            >{totalInicial} profesionales</span
          >
        </div>
      </div>
    </section>

    <section id="zk-direccion" style="padding: 56px 24px 0;" data-sedes={direccion.sedes.join('|')}>
      <div
        style="max-width: var(--container-max); margin: 0 auto; border: 1px solid var(--border-subtle); background: var(--surface-section); padding: 44px 44px 48px; display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 24px 56px; align-items: start;"
      >
        <div
          role="img"
          aria-label={direccion.alt}
          class="zk-retrato zk-retrato--destacado" style={`flex: none; width: 100%; aspect-ratio: 3 / 4; background-image: url("${direccion.foto}");`}
        >
        </div>
        <div>
          <h2
            style="font-size: 13px; font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--zk-teal-700); margin: 0;"
          >
            Dirección Clínica
          </h2>
          <div
            style="font-size: 24px; font-weight: var(--fw-semibold); color: var(--text-heading); margin-top: 12px; line-height: var(--lh-tight);"
          >
            {direccion.name}
          </div>
          <div style="font-size: 15px; margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
            <span>{direccion.area}</span>
            {direccion.tags.map((t) => <span style={t.style}>{t.label}</span>)}
          </div>
          <p style="font-size: 15.5px; line-height: var(--lh-body); margin: 22px 0 0; text-wrap: pretty;">
            {direccion.bio}
          </p>
          <p style="font-size: 15.5px; line-height: var(--lh-body); margin: 12px 0 0; text-wrap: pretty;">
            {direccion.bioDir}
          </p>
          <div style="margin-top: 24px; display: flex; gap: 8px; flex-wrap: wrap;">
            {
              direccion.actions.map((a) => (
                <a href={a.href} target="_blank" rel="noopener" class="zk-brillo" style={a.style}>
                  {a.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section style="padding: 56px 24px 120px;">
      <div
        id="zk-grilla"
        style="max-width: var(--container-max); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 1px; background: var(--border-subtle); border: 1px solid var(--border-subtle); animation: zkfade .3s var(--ease-out);"
      >
        {
          visible.map((d) => (
            <div
              data-ficha
              data-sedes={d.sedes.join('|')}
              style="background: var(--zk-white); padding: 40px 38px 44px; display: flex; flex-direction: column;"
            >
              <div style="display: flex; gap: 22px; align-items: flex-start;">
                <div
                  role="img"
                  aria-label={d.alt}
                  class="zk-retrato" style={`flex: none; width: 116px; aspect-ratio: 3 / 4; background-image: url("${d.foto}"); background-size: cover; background-position: center bottom;`}
                />
                <div style="flex: 1 1 auto; min-width: 0;">
                  <div style="font-size: 19px; font-weight: var(--fw-semibold); color: var(--text-heading); line-height: var(--lh-tight);">
                    {d.name}
                  </div>
                  <div style="font-size: 14.5px; margin-top: 8px; color: var(--text-body);">{d.area}</div>
                  <div style="margin-top: 10px; display: flex; gap: 6px; flex-wrap: wrap;">
                    {d.tags.map((t) => (
                      <span style={t.style}>{t.label}</span>
                    ))}
                  </div>
                </div>
              </div>
              <p style="font-size: 15px; line-height: var(--lh-body); margin: 22px 0 0; text-wrap: pretty;">{d.bio}</p>
              <div style="margin-top: auto; padding-top: 26px; display: grid; gap: 8px;">
                {d.actions.map((a) => (
                  <a href={a.href} target="_blank" rel="noopener" class="zk-brillo" style={a.style}>
                    {a.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section style="position: relative; overflow: hidden; background: var(--surface-section); padding: 120px 24px;">
      <div
        aria-hidden="true"
        class="zk-marca-confianza"
        style={`position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 720px; height: 736px; background: url(${isotipo.src}) center / contain no-repeat; opacity: .055; pointer-events: none;`}
      >
      </div>
      <p
        style="position: relative; max-width: 1000px; margin: 0 auto; font-size: clamp(20px, 1.8vw, 28px); font-weight: var(--fw-light); color: var(--text-heading); line-height: var(--lh-tight); text-align: center; text-wrap: pretty;"
      >
        La confianza también se construye sabiendo quién te acompaña<span style="color: var(--zk-teal-600);">.</span>
      </p>
    </section>

    <SiteFooter />
    <WhatsAppFab hrefLa={fabLa} hrefPu={fabPu} />
  </div>
</Layout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-filtro]'));
  const fichas = Array.from(document.querySelectorAll<HTMLElement>('[data-ficha]'));
  const direccion = document.getElementById('zk-direccion');
  const grilla = document.getElementById('zk-grilla');
  const conteo = document.getElementById('zk-conteo');

  const enFiltro = (el: HTMLElement, filtro: string) =>
    filtro === 'Todo el equipo' || (el.dataset.sedes ?? '').split('|').includes(filtro);

  const aplicar = (filtro: string) => {
    chips.forEach((c) => c.toggleAttribute('data-activo', c.dataset.filtro === filtro));

    let total = 0;
    fichas.forEach((f) => {
      const dentro = enFiltro(f, filtro);
      f.hidden = !dentro;
      if (dentro) total++;
    });

    if (direccion) {
      const dentro = enFiltro(direccion, filtro);
      direccion.hidden = !dentro;
      if (dentro) total++;
    }

    if (conteo) conteo.textContent = total + (total === 1 ? ' profesional' : ' profesionales');

    // Repite el fade .3s de la grilla al cambiar de filtro.
    if (grilla) {
      grilla.style.animation = 'none';
      void grilla.offsetWidth;
      grilla.style.animation = 'zkfade .3s var(--ease-out)';
    }
  };

  chips.forEach((c) => c.addEventListener('click', () => aplicar(c.dataset.filtro!)));

  // ?sede=Pucón / ?sede=Los Ángeles preselecciona el filtro, como en el prototipo.
  const inicial = new URLSearchParams(location.search).get('sede');
  if (inicial === 'Pucón' || inicial === 'Los Ángeles') aplicar(inicial);
</script>

<style>
  /* Los retratos del equipo son recortes sobre fondo transparente, normalizados a
     3:4 con el mismo aire sobre la cabeza. Sin un fondo detrás flotarían sobre el
     blanco de la página; el tinte de marca los asienta y unifica la grilla, que
     antes mezclaba murales, paredes y salas de cada foto de contexto. */
  .zk-retrato {
    background-color: var(--zk-teal-50);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center bottom;
  }

  /* La ficha destacada necesita un encuadre propio: su retrato es de cuerpo
     entero, y a la misma escala que la grilla la persona que encabeza el equipo
     se leía más chica que el resto. Con este acercamiento el rostro toma el
     tamaño de los demás y la carpeta de Familia ZK que sostiene queda legible. */
  .zk-retrato--destacado {
    background-size: 135%;
    background-position: center 10%;
  }

  .zk-chip {
    padding: 9px 16px;
    font-size: 14px;
    font-family: var(--font-sans);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.18s var(--ease-out);
    background: var(--zk-white);
    color: var(--text-body);
    border: 1px solid var(--border-subtle);
  }
  .zk-chip[data-activo] {
    background: var(--zk-teal-600);
    color: #fff;
    border: 1px solid var(--zk-teal-600);
    font-weight: var(--fw-semibold);
  }
  .zk-brillo:hover {
    filter: brightness(1.07);
    color: #fff;
    text-decoration: none;
  }
  .zk-brillo:active {
    filter: brightness(0.95);
    transform: translateY(1px);
  }
</style>
