---
/* Galería de sede — imagen 4:3, flechas circulares al hover, contador y tira de
   miniaturas de 54px unidas por 1px. El caption es el alt de la foto activa. */
import { getImage } from 'astro:assets';
import type { Foto } from '../../data/sucursales';
import { fotos as mapaFotos } from '../../lib/imagenes';

interface Props {
  id: string;
  fotos: Foto[];
}

const { id, fotos } = Astro.props;

const items = await Promise.all(
  fotos.map(async (f) => ({
    alt: f.alt,
    grande: (await getImage({ src: mapaFotos[f.src], width: 1200, format: 'webp' })).src,
    mini: (await getImage({ src: mapaFotos[f.src], width: 220, format: 'webp' })).src,
  }))
);
---

<div data-galeria={id}>
  <div class="zk-gal">
    <img
      src={items[0].grande}
      alt={items[0].alt}
      data-principal
      style="width: 100%; height: 100%; object-fit: cover; display: block; animation: zkfade .3s var(--ease-out);"
    />
    <button type="button" data-gal="prev" aria-label="Foto anterior" class="zk-nav zk-nav--prev">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
    </button>
    <button type="button" data-gal="next" aria-label="Foto siguiente" class="zk-nav zk-nav--next">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
    </button>
    <div
      style="position: absolute; top: 12px; right: 14px; background: rgba(47,63,66,.55); color: #fff; font-size: 12px; padding: 3px 9px; border-radius: 999px; font-variant-numeric: tabular-nums;"
    >
      <span data-contador>1</span> / {items.length}
    </div>
  </div>

  <div
    style={`display: grid; grid-template-columns: repeat(${items.length}, 1fr); gap: 1px; background: var(--border-subtle); margin-top: 1px;`}
  >
    {
      items.map((it, j) => (
        <button type="button" data-mini={j} aria-label={it.alt} class="zk-mini" data-activa={j === 0 ? '' : undefined}>
          <img src={it.mini} alt="" style="width: 100%; height: 54px; object-fit: cover; display: block;" />
        </button>
      ))
    }
  </div>

  <p style="font-size: 15px; line-height: var(--lh-body); color: var(--text-muted); margin: 14px 0 0;" data-caption>
    {items[0].alt}
  </p>

  <script type="application/json" data-fotos set:html={JSON.stringify(items)} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-galeria]').forEach((raiz) => {
    const datos = JSON.parse(raiz.querySelector('[data-fotos]')!.textContent!) as {
      alt: string;
      grande: string;
    }[];
    const principal = raiz.querySelector<HTMLImageElement>('[data-principal]')!;
    const contador = raiz.querySelector<HTMLElement>('[data-contador]')!;
    const caption = raiz.querySelector<HTMLElement>('[data-caption]')!;
    const minis = Array.from(raiz.querySelectorAll<HTMLElement>('[data-mini]'));
    /* `pedido` es el índice que el visitante ya solicitó, y avanza en el mismo
       instante del toque aunque la foto todavía se esté descargando. Las flechas
       navegan desde ahí: si navegaran desde el índice que está en pantalla,
       cinco toques seguidos avanzarían dos fotos en vez de cinco, porque los
       toques intermedios leerían un índice que aún no se ha movido. */
    let pedido = 0;
    // Identifica cada cambio en curso: si el visitante toca la flecha otra vez
    // mientras una foto todavía se descarga, la primera ya no debe pintarse.
    let turno = 0;
    // Hay una foto descargándose en este momento.
    let enVuelo = false;

    /** Deja una foto descargada y decodificada en el navegador, sin mostrarla. */
    const precargar = (n: number) => {
      const im = new Image();
      im.src = datos[(n + datos.length) % datos.length].grande;
      return im;
    };

    const mostrar = async (n: number) => {
      const idx = (n + datos.length) % datos.length;
      pedido = idx;
      const mio = ++turno;

      /* La miniatura activa se marca de inmediato, antes de esperar la descarga:
         es el acuse de recibo del toque. Con una conexión lenta la foto puede
         tardar medio segundo en estar lista, y sin esta señal el control parece
         no haber respondido. El contador y el pie viajan junto con la foto para
         que nunca describan una imagen que todavía no está en pantalla. */
      minis.forEach((m, j) => m.toggleAttribute('data-activa', j === idx));

      /* Si ya hay una foto descargándose, se deja pasar un respiro antes de
         pedir esta. Con una conexión lenta, tocar la flecha cinco veces seguidas
         lanzaba cinco descargas peleando el mismo ancho de banda y la última
         llegaba mucho más tarde. Con el respiro sólo se descarga aquella en la
         que el visitante se detiene. Un toque aislado no paga nada: la condición
         sólo se cumple si hay algo en vuelo. */
      if (enVuelo) {
        await new Promise((r) => setTimeout(r, 90));
        if (mio !== turno) return;
      }

      /* Se espera a que la foto esté lista ANTES de tocar el <img>.
         Antes se asignaba `src` y se reiniciaba el fundido en el mismo gesto:
         como la foto nueva todavía no había llegado, el navegador seguía
         pintando la anterior, así que lo que se desvanecía y volvía era la foto
         que salía, y recién después aparecía la nueva. Eso era el parpadeo.
         Ahora el fundido acompaña a la foto que entra, que es lo que el diseño
         pide. */
      const previa = new Image();
      previa.src = datos[idx].grande;
      enVuelo = true;
      try {
        await previa.decode();
      } catch {
        /* Si la descarga falla se sigue igual: el <img> mostrará lo que pueda. */
      }
      if (mio !== turno) return;
      enVuelo = false;

      principal.src = datos[idx].grande;
      principal.alt = datos[idx].alt;
      // Reinicia el fade de entrada de la foto.
      principal.style.animation = 'none';
      void principal.offsetWidth;
      principal.style.animation = 'zkfade .3s var(--ease-out)';
      contador.textContent = String(idx + 1);
      caption.textContent = datos[idx].alt;

      // Las vecinas quedan listas para que el clic siguiente no espere nada.
      precargar(idx + 1);
      precargar(idx - 1);
    };

    raiz.querySelector('[data-gal="prev"]')?.addEventListener('click', () => mostrar(pedido - 1));
    raiz.querySelector('[data-gal="next"]')?.addEventListener('click', () => mostrar(pedido + 1));
    minis.forEach((m, j) => m.addEventListener('click', () => mostrar(j)));

    /* Las vecinas de la primera foto se precargan recién cuando la galería
       entra en pantalla, no al cargar la página: en Sucursales las dos galerías
       están bien abajo y adelantar cuatro fotos encarecería la primera carga
       para quien nunca llega a verlas. */
    const obs = new IntersectionObserver(
      (entradas) => {
        if (!entradas[0].isIntersecting) return;
        obs.disconnect();
        precargar(1);
        precargar(-1);
      },
      { rootMargin: '200px' }
    );
    obs.observe(raiz);
  });
</script>

<style>
  .zk-gal {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--surface-section);
  }
  .zk-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: none;
    background: rgba(255, 255, 255, 0.92);
    color: var(--text-heading);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-card);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      background 0.2s ease;
  }
  .zk-nav--prev {
    left: 12px;
  }
  .zk-nav--next {
    right: 12px;
  }
  .zk-gal:hover .zk-nav,
  .zk-gal:focus-within .zk-nav {
    opacity: 1;
  }
  .zk-nav:hover {
    background: #fff;
  }
  @media (hover: none) {
    .zk-nav {
      opacity: 1;
    }
  }
  .zk-mini {
    padding: 0;
    border: none;
    cursor: pointer;
    display: block;
    background: var(--zk-white);
    transition: opacity 0.2s var(--ease-out);
    opacity: 0.5;
    outline: none;
    outline-offset: -2px;
  }
  .zk-mini[data-activa] {
    opacity: 1;
    outline: 2px solid var(--color-primary);
  }
</style>
