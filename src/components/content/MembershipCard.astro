---
/* MembershipCardV2.jsx — tarjeta de membresía de la grilla de 4.
   `onCta` (Inicio) abre el modal del afiche; sin él, el CTA navega a la página. */
import { ACCENTS, GRAD, type ClaveMembresia } from '../../data/membresias';
import { isotipo } from '../../lib/imagenes';

interface Props {
  membership: ClaveMembresia;
  name: string;
  motto?: string;
  headline?: string;
  tagline?: string;
  features?: string[];
  ctaLabel?: string;
  ctaHref: string;
  /** Inicio intercepta el clic para abrir el modal en vez de navegar. */
  abreModal?: boolean;
  highlighted?: boolean;
}

const {
  membership,
  name,
  motto,
  headline,
  tagline,
  features = [],
  ctaLabel = 'Ver más',
  ctaHref,
  abreModal = false,
  highlighted = false,
} = Astro.props;

const accent = ACCENTS[membership] ?? ACCENTS.anticipa;
const grad = GRAD[membership] ?? GRAD.anticipa;
const parts = String(name ?? '').trim().split(/\s+/);
const brand = parts.length > 1 ? parts[0] : 'ZK';
const label = parts.length > 1 ? parts.slice(1).join(' ') : name;
---

<div class="zk-mc" data-hl={highlighted ? '' : undefined}>
  <div class="zk-mc__top" style={`background: ${grad};`}>
    <div style="position: relative; z-index: 1;">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
        <span
          style="font-size: 27px; font-weight: var(--fw-light); letter-spacing: .02em; text-transform: uppercase; line-height: 1.1;"
          >{brand}</span
        >
        <span
          aria-hidden="true"
          style="flex: 0 0 auto; width: 38px; height: 38px; border-radius: 50%; background: #fff; display: inline-flex; align-items: center; justify-content: center;"
        >
          <img src={isotipo.src} alt="" style="width: 72%; height: 72%; object-fit: contain;" />
        </span>
      </div>
      <div
        style={`margin-top: 2px; font-size: ${String(label).length > 9 ? 20 : 23}px; font-weight: var(--fw-light); letter-spacing: .02em; text-transform: uppercase; line-height: 27px; height: 27px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;`}
      >
        {label}
      </div>
      <div
        style="margin-top: 12px; font-size: 17.5px; font-weight: var(--fw-light); line-height: 25px; height: 50px; overflow: hidden; opacity: .96; max-width: 82%;"
      >
        {motto ?? ''}
      </div>
    </div>
    <svg
      viewBox="0 0 320 60"
      preserveAspectRatio="none"
      aria-hidden="true"
      style="position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 60px; opacity: .34;"
    >
      <path d="M120 58 C 200 34, 250 36, 340 8" fill="none" stroke="#fff" stroke-width="1.1"></path>
    </svg>
  </div>

  <div style="padding: 20px 24px 24px; display: flex; flex-direction: column; gap: 14px; flex: 1;">
    {
      headline && (
        <p style="margin: 0; font-size: 17px; font-weight: var(--fw-semibold); color: var(--text-heading); line-height: 1.3;">
          {headline}
        </p>
      )
    }
    {
      tagline && (
        <p style="margin: 0; font-size: 15px; color: var(--text-body); line-height: var(--lh-body, 1.55);">{tagline}</p>
      )
    }
    {
      features.length > 0 && (
        <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px;">
          {features.map((feat) => (
            <li style="display: flex; gap: 10px; font-size: 15px; color: var(--text-body);">
              <span style={`color: ${accent}; font-weight: var(--fw-bold); line-height: 1.5;`}>✓</span>
              {feat}
            </li>
          ))}
        </ul>
      )
    }
    <div style="margin-top: auto; padding-top: 8px; display: flex; justify-content: center;">
      <a
        href={ctaHref}
        class="zk-mc__cta"
        data-afiche={abreModal ? membership : undefined}
        style={`background: ${grad};`}>{ctaLabel}</a
      >
    </div>
  </div>
</div>

<style>
  .zk-mc {
    background: var(--zk-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    font-family: var(--font-sans);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    transition:
      box-shadow 0.2s var(--ease-out),
      filter 0.2s var(--ease-out);
  }
  .zk-mc[data-hl],
  .zk-mc:hover {
    box-shadow: var(--shadow-raised);
  }
  .zk-mc:hover {
    filter: brightness(1.02);
  }
  .zk-mc__top {
    position: relative;
    color: #fff;
    padding: 24px 24px 26px;
    overflow: hidden;
    height: 180px;
    box-sizing: border-box;
  }
  .zk-mc__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: var(--fw-regular);
    letter-spacing: 0.01em;
    border-radius: var(--radius-md);
    text-decoration: none;
    border: none;
    color: #fff;
    box-shadow:
      0 2px 10px rgba(47, 63, 66, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    transition:
      filter 0.18s var(--ease-out),
      transform 0.12s var(--ease-out),
      box-shadow 0.18s var(--ease-out);
  }
  .zk-mc__cta:hover {
    filter: brightness(1.07);
    color: #fff;
    text-decoration: none;
  }
  .zk-mc__cta:active {
    filter: brightness(0.95);
    transform: translateY(1px);
    box-shadow:
      0 1px 4px rgba(47, 63, 66, 0.16),
      inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
</style>
