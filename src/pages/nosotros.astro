---
/* Nosotros (/nosotros) — Nosotros v3.dc.html. */
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import WhatsAppFab from '../components/site/WhatsAppFab.astro';
import SectionHeader from '../components/core/SectionHeader.astro';
import { getImage } from 'astro:assets';
import { ruta } from '../data/navegacion';
import { waConsultaSede } from '../data/contacto';
import { fotos, isotipo } from '../lib/imagenes';

const fabHref = waConsultaSede('Pucón');

const principios = [
  {
    title: 'Claridad para decidir',
    body: 'Explicamos la situación, las alternativas y los pasos necesarios para que cada paciente pueda tomar decisiones informadas.',
  },
  {
    title: 'Coordinación para avanzar',
    body: 'Cuando un caso requiere distintas áreas, buscamos articular la atención para que el proceso mantenga orden y continuidad.',
  },
  {
    title: 'Prevención para anticiparse',
    body: 'Promovemos controles y hábitos que ayuden a detectar necesidades antes de que se conviertan en situaciones más complejas.',
  },
  {
    title: 'Cercanía para acompañar',
    body: 'Sabemos que detrás de cada consulta hay una persona con preguntas, expectativas y experiencias distintas. Por eso, la forma de atender también importa.',
  },
];

const kit = await getImage({ src: fotos['pu-dra-romina-kit-familia-zk.jpg'], width: 900, format: 'webp' });
---

<Layout
  title="Quiénes Somos | Clínica ZK"
  description="Conoce la historia y la forma de cuidar que comparten las sedes de Clínica ZK en Los Ángeles y Pucón."
>
  <div style="font-family: var(--font-sans); color: var(--text-body);">
    <SiteHeader active="Nosotros" />

    <section class="zk-nos-hero" style="position: relative; overflow: hidden; padding: 104px 24px 0;">
      <div
        aria-hidden="true"
        class="zk-nos-marca-hero"
        style={`position: absolute; top: -110px; right: -90px; width: 620px; height: 634px; background: url(${isotipo.src}) center / contain no-repeat; opacity: .055; pointer-events: none;`}
      >
      </div>
      <div style="position: relative; max-width: var(--container-max); margin: 0 auto;">
        <div style="max-width: 900px; margin: 0 auto; text-align: center;">
          <div
            style="font-size: 12px; font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--zk-teal-600);"
          >
            Quiénes somos
          </div>
          <h1
            style="font-size: clamp(34px, 3.9vw, 60px); font-weight: var(--fw-light); line-height: 1.07; color: var(--text-heading); margin: 20px 0 0; text-wrap: pretty;"
          >
            Una clínica que crece sin perder la cercanía.
          </h1>
        </div>
        <div
          class="zk-nos-intro"
          style="margin: 72px auto 0; max-width: 1240px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px 72px;"
        >
          <p style="font-size: 16.5px; line-height: var(--lh-body); margin: 0; text-wrap: pretty;">
            Clínica ZK nació en Los Ángeles con la convicción de que una buena atención dental debía ser clara, cercana y
            capaz de acompañar a las personas más allá de una consulta aislada.
          </p>
          <p style="font-size: 16.5px; line-height: var(--lh-body); margin: 0; text-wrap: pretty;">
            Con el tiempo, ese proyecto creció y llegó a Pucón, ampliando la presencia de la clínica sin cambiar su forma
            de entender el cuidado: escuchar, evaluar con criterio, explicar cada paso y dar continuidad a los procesos.
          </p>
          <p style="font-size: 16.5px; line-height: var(--lh-body); margin: 0; text-wrap: pretty;">
            Hoy, ambas sedes reúnen profesionales de distintas áreas, servicios de apoyo diagnóstico y equipos que
            trabajan para que cada paciente pueda comprender qué necesita y avanzar con una ruta de atención más
            ordenada.
          </p>
        </div>
        <p
          class="zk-nos-pull"
          style="font-size: clamp(20px, 1.9vw, 30px); font-weight: var(--fw-light); color: var(--text-heading); line-height: var(--lh-tight); margin: 96px auto 0; max-width: 1000px; text-align: center; text-wrap: pretty;"
        >
          Crecer no significa solamente atender a más personas. También significa construir mejores formas de
          acompañarlas<span style="color: var(--zk-teal-600);">.</span>
        </p>
      </div>
    </section>

    <section class="zk-nos-s-historia" style="padding: 112px 24px 0;">
      <div
        class="zk-nos-historia-grid"
        style="max-width: 1240px; margin: 0 auto; border-top: 1px solid var(--border-subtle); padding-top: 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 56px;"
      >
        <div>
          <div
            style="font-size: 12px; font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--zk-teal-600); text-align: center;"
          >
            Nuestra historia
          </div>
          <h2
            style="font-size: clamp(19px, 1.5vw, 25px); font-weight: var(--fw-light); color: var(--text-heading); line-height: var(--lh-tight); margin: 16px 0 0; max-width: 30ch; text-wrap: pretty;"
          >
            Un proyecto que comenzó en Los Ángeles y hoy también forma parte de Pucón.
          </h2>
          <p style="font-size: 15.5px; line-height: var(--lh-body); margin: 24px 0 0; text-wrap: pretty;">
            Clínica ZK comenzó su desarrollo en Los Ángeles, construyendo una propuesta odontológica basada en la
            atención integral, la incorporación de distintas áreas clínicas y el acompañamiento de pacientes y familias.
          </p>
          <p style="font-size: 15.5px; line-height: var(--lh-body); margin: 14px 0 0; text-wrap: pretty;">
            La apertura de la sede Pucón permitió extender esa experiencia a una nueva comunidad, manteniendo la cercanía
            como parte esencial de la atención y fortaleciendo la posibilidad de acceder a especialidades y apoyo
            diagnóstico dentro de la ciudad.
          </p>
        </div>
        <div>
          <div
            style="font-size: 12px; font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--color-secondary); text-align: center;"
          >
            Nuestra convicción
          </div>
          <h2
            style="font-size: clamp(19px, 1.5vw, 25px); font-weight: var(--fw-light); color: var(--text-heading); line-height: var(--lh-tight); margin: 16px 0 0; max-width: 30ch; text-wrap: pretty;"
          >
            Una buena atención comienza antes del tratamiento.
          </h2>
          <p style="font-size: 15.5px; line-height: var(--lh-body); margin: 24px 0 0; text-wrap: pretty;">
            Creemos que cuidar no consiste solamente en realizar un procedimiento. También implica escuchar, evaluar,
            explicar, resolver dudas y ayudar a cada paciente a comprender los pasos que vienen.
          </p>
          <p style="font-size: 15.5px; line-height: var(--lh-body); margin: 14px 0 0; text-wrap: pretty;">
            Cuando una persona conoce su situación y entiende sus alternativas, puede tomar decisiones con mayor
            tranquilidad y participar activamente en el cuidado de su salud dental.
          </p>
        </div>
      </div>
    </section>

    <section class="zk-nos-s-crecimiento" style="padding: 112px 24px 0;">
      <div
        class="zk-nos-crecimiento-grid"
        style="max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 0.6fr 0.4fr; gap: 56px; align-items: center;"
      >
        <div>
          <div
            style="font-size: 12px; font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--zk-teal-600); text-align: center;"
          >
            Nuestro crecimiento
          </div>
          <h2
            style="font-size: clamp(22px, 2vw, 32px); font-weight: var(--fw-light); color: var(--text-heading); line-height: var(--lh-tight); margin: 16px 0 0; text-wrap: pretty;"
          >
            Crecemos para responder mejor.
          </h2>
          <p style="font-size: 16.5px; line-height: var(--lh-body); margin: 28px 0 0; max-width: 62ch; text-wrap: pretty;">
            El crecimiento de Clínica ZK ha significado incorporar profesionales, especialidades, tecnología,
            herramientas de diagnóstico y nuevas formas de acompañar a quienes necesitan prevención, tratamiento o
            seguimiento.
          </p>
          <p style="font-size: 16.5px; line-height: var(--lh-body); margin: 14px 0 0; max-width: 62ch; text-wrap: pretty;">
            Cada avance busca fortalecer una atención más coordinada, facilitar el acceso a distintas soluciones y evitar
            que el paciente tenga que enfrentar su proceso sin una orientación clara.
          </p>
        </div>
        <figure style="margin: 0;">
          <img
            src={kit.src}
            alt="Dirección Clínica con el kit de incorporación Familia ZK en la sede de Pucón."
            style="width: 100%; aspect-ratio: 1 / 1; object-fit: cover; object-position: center 46%; display: block;"
          />
          <figcaption
            style="font-size: 14px; line-height: var(--lh-body); color: var(--text-muted); margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-subtle); text-wrap: pretty;"
          >
            Kit de incorporación Familia ZK, en la sede de Pucón.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="zk-nos-s-dossedes" style="padding: 112px 24px 0;">
      <div
        class="zk-nos-dossedes-inner"
        style="max-width: 1100px; margin: 0 auto; border-top: 1px solid var(--border-subtle); padding-top: 56px; text-align: center;"
      >
        <h2
          style="font-size: clamp(22px, 2vw, 32px); font-weight: var(--fw-light); color: var(--text-heading); line-height: var(--lh-tight); margin: 0; white-space: nowrap;"
        >
          Dos sedes, un mismo compromiso.
        </h2>
        <div style="margin-top: 32px;">
          <p style="font-size: 16.5px; line-height: var(--lh-body); margin: 0; text-wrap: pretty;">
            Pucón y Los Ángeles tienen equipos, agendas y características propias. Sin embargo, ambas sedes comparten una
            misma manera de trabajar: actuar con responsabilidad clínica, cuidar la experiencia del paciente y procurar
            que cada proceso tenga claridad y continuidad.
          </p>
          <p
            style="font-size: 16.5px; line-height: var(--lh-body); margin: 20px 0 0; color: var(--text-heading); text-wrap: pretty;"
          >
            Nuestra identidad no depende solamente del lugar donde atendemos, sino de la forma en que acompañamos.
          </p>
        </div>
      </div>
    </section>

    <section class="zk-nos-s-principios" style="padding: 112px 24px 120px;">
      <div style="max-width: var(--container-max); margin: 0 auto;">
        <SectionHeader align="center" title="Principios de atención" />
        <div
          class="zk-nos-principios-grid"
          style="margin: 48px auto 0; max-width: 1000px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--border-subtle); border: 1px solid var(--border-subtle);"
        >
          {
            principios.map((p) => (
              <div style="background: var(--zk-white); padding: 44px 44px 48px;">
                <div style="font-size: 18px; font-weight: var(--fw-semibold); color: var(--text-heading); text-align: center;">
                  {p.title}
                </div>
                <p style="font-size: 15.5px; line-height: var(--lh-body); margin: 16px 0 0; text-wrap: pretty;">
                  {p.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="zk-nos-s-cierre" style="position: relative; overflow: hidden; background: var(--surface-section); padding: 120px 24px;">
      <div
        aria-hidden="true"
        class="zk-nos-marca-cierre"
        style={`position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 760px; height: 777px; background: url(${isotipo.src}) center / contain no-repeat; opacity: .05; pointer-events: none;`}
      >
      </div>
      <div style="position: relative; max-width: 1000px; margin: 0 auto; text-align: center;">
        <p style="font-size: 16.5px; line-height: var(--lh-body); margin: 0; text-wrap: pretty;">
          En Clínica ZK queremos que cada persona encuentre más que una solución puntual. Queremos que pueda comprender
          su salud dental, acceder al profesional que necesita y saber cómo continuar.
        </p>
        <p
          style="font-size: clamp(20px, 1.8vw, 28px); font-weight: var(--fw-light); color: var(--text-heading); line-height: var(--lh-tight); margin: 40px 0 0; padding-top: 40px; border-top: 1px solid var(--border-subtle); text-wrap: pretty;"
        >
          Tu cuidado puede comenzar con una consulta, pero se construye con continuidad<span
            style="color: var(--zk-teal-600);">.</span
          >
        </p>
        <div style="margin-top: 44px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
          <a href={ruta('/equipo-clinico')} class="zk-btn-pri-link">Conoce a nuestro equipo</a>
          <a href={ruta('/sucursales')} class="zk-btn-sec">Encuentra tu sede</a>
        </div>
      </div>
    </section>

    <SiteFooter />
    <WhatsAppFab href={fabHref} />
  </div>
</Layout>

<style>
  .zk-btn-pri-link {
    display: inline-flex;
    align-items: center;
    padding: 13px 26px;
    font-size: 15px;
    font-weight: var(--fw-semibold);
    color: #fff;
    text-decoration: none;
    border-radius: var(--radius-md);
    background:
      radial-gradient(130% 120% at 18% 0%, #63c6c0 0%, rgba(99, 198, 192, 0) 55%),
      linear-gradient(105deg, #46b3ad 0%, #2e9a94 60%, #1e827d 100%);
    box-shadow:
      0 2px 10px rgba(47, 63, 66, 0.2),
      inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    transition: filter 0.18s var(--ease-out);
  }
  .zk-btn-pri-link:hover {
    filter: brightness(1.07);
    color: #fff;
    text-decoration: none;
  }
  .zk-btn-sec {
    display: inline-flex;
    align-items: center;
    padding: 13px 26px;
    font-size: 15px;
    color: var(--text-heading);
    text-decoration: none;
    border: 1px solid var(--border-subtle);
    background: var(--zk-white);
    border-radius: var(--radius-md);
    transition:
      border-color 0.18s var(--ease-out),
      color 0.18s var(--ease-out);
  }
  .zk-btn-sec:hover {
    border-color: var(--zk-teal-500);
    color: var(--zk-teal-700);
    text-decoration: none;
  }
</style>
