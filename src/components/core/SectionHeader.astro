---
/* SectionHeader del design system (components/core/SectionHeader.jsx). */
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
}

const { eyebrow, title, subtitle, align = 'center' } = Astro.props;
---

<div
  class="zk-section-header"
  style={`text-align: ${align}; max-width: 720px; margin: ${align === 'center' ? '0 auto' : 0}; font-family: var(--font-sans);`}
>
  {
    eyebrow && (
      <div
        style="font-size: var(--fs-small); letter-spacing: var(--ls-eyebrow); color: var(--color-primary); font-weight: var(--fw-semibold); text-transform: uppercase; margin-bottom: 12px;"
      >
        {eyebrow}
      </div>
    )
  }
  <h2 style="font-size: var(--fs-h2); margin: 0;">{title}</h2>
  {
    subtitle && (
      <p style="font-size: var(--fs-body-lg); color: var(--text-body); margin-top: 14px; margin-bottom: 0;">
        {subtitle}
      </p>
    )
  }
</div>
