---
/* Galería de sede — imagen 4:3, flechas circulares al hover, contador y tira de
   miniaturas de 54px unidas por 1px. El caption es el alt de la foto activa. */
import { getImage } from 'astro:assets';
import type { Foto } from '../../data/sucursales';
import { fotos as mapaFotos } from '../../lib/imagenes';

interface Props {
  id: string;
  fotos: Foto[];
}

const { id, fotos } = Astro.props;

const items = await Promise.all(
  fotos.map(async (f) => ({
    alt: f.alt,
    grande: (await getImage({ src: mapaFotos[f.src], width: 1200, format: 'webp' })).src,
    mini: (await getImage({ src: mapaFotos[f.src], width: 220, format: 'webp' })).src,
  }))
);
---

<div data-galeria={id}>
  <div class="zk-gal">
    <img
      src={items[0].grande}
      alt={items[0].alt}
      data-principal
      style="width: 100%; height: 100%; object-fit: cover; display: block; animation: zkfade .3s var(--ease-out);"
    />
    <button type="button" data-gal="prev" aria-label="Foto anterior" class="zk-nav zk-nav--prev">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
    </button>
    <button type="button" data-gal="next" aria-label="Foto siguiente" class="zk-nav zk-nav--next">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
    </button>
    <div
      style="position: absolute; top: 12px; right: 14px; background: rgba(47,63,66,.55); color: #fff; font-size: 12px; padding: 3px 9px; border-radius: 999px; font-variant-numeric: tabular-nums;"
    >
      <span data-contador>1</span> / {items.length}
    </div>
  </div>

  <div
    style={`display: grid; grid-template-columns: repeat(${items.length}, 1fr); gap: 1px; background: var(--border-subtle); margin-top: 1px;`}
  >
    {
      items.map((it, j) => (
        <button type="button" data-mini={j} aria-label={it.alt} class="zk-mini" data-activa={j === 0 ? '' : undefined}>
          <img src={it.mini} alt="" style="width: 100%; height: 54px; object-fit: cover; display: block;" />
        </button>
      ))
    }
  </div>

  <p style="font-size: 15px; line-height: var(--lh-body); color: var(--text-muted); margin: 14px 0 0;" data-caption>
    {items[0].alt}
  </p>

  <script type="application/json" data-fotos set:html={JSON.stringify(items)} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-galeria]').forEach((raiz) => {
    const datos = JSON.parse(raiz.querySelector('[data-fotos]')!.textContent!) as {
      alt: string;
      grande: string;
    }[];
    const principal = raiz.querySelector<HTMLImageElement>('[data-principal]')!;
    const contador = raiz.querySelector<HTMLElement>('[data-contador]')!;
    const caption = raiz.querySelector<HTMLElement>('[data-caption]')!;
    const minis = Array.from(raiz.querySelectorAll<HTMLElement>('[data-mini]'));
    let i = 0;

    const mostrar = (n: number) => {
      i = (n + datos.length) % datos.length;
      principal.src = datos[i].grande;
      principal.alt = datos[i].alt;
      // Reinicia el fade de entrada de la foto.
      principal.style.animation = 'none';
      void principal.offsetWidth;
      principal.style.animation = 'zkfade .3s var(--ease-out)';
      contador.textContent = String(i + 1);
      caption.textContent = datos[i].alt;
      minis.forEach((m, j) => m.toggleAttribute('data-activa', j === i));
    };

    raiz.querySelector('[data-gal="prev"]')?.addEventListener('click', () => mostrar(i - 1));
    raiz.querySelector('[data-gal="next"]')?.addEventListener('click', () => mostrar(i + 1));
    minis.forEach((m, j) => m.addEventListener('click', () => mostrar(j)));
  });
</script>

<style>
  .zk-gal {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--surface-section);
  }
  .zk-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: none;
    background: rgba(255, 255, 255, 0.92);
    color: var(--text-heading);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-card);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      background 0.2s ease;
  }
  .zk-nav--prev {
    left: 12px;
  }
  .zk-nav--next {
    right: 12px;
  }
  .zk-gal:hover .zk-nav,
  .zk-gal:focus-within .zk-nav {
    opacity: 1;
  }
  .zk-nav:hover {
    background: #fff;
  }
  @media (hover: none) {
    .zk-nav {
      opacity: 1;
    }
  }
  .zk-mini {
    padding: 0;
    border: none;
    cursor: pointer;
    display: block;
    background: var(--zk-white);
    transition: opacity 0.2s var(--ease-out);
    opacity: 0.5;
    outline: none;
    outline-offset: -2px;
  }
  .zk-mini[data-activa] {
    opacity: 1;
    outline: 2px solid var(--color-primary);
  }
</style>
