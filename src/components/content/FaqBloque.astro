---
/* FaqBloqueV3.dc.html — acordeón por tema. El bloque no imprime el nombre del tema
   ni la bajada: el titular «Preguntas frecuentes» se basta solo. */
import FaqItem from './FaqItem.astro';
import { faqsDeTema, type TemaFaq } from '../../data/faq';

interface Props {
  tema?: TemaFaq;
}

const { tema = 'Atención' } = Astro.props;
const faqs = faqsDeTema(tema);
---

<section style="padding: var(--space-9) 24px; font-family: var(--font-sans); color: var(--text-body);">
  <div style="max-width: var(--container-max, min(1520px, 94vw)); margin: 0 auto;">
    <div style="padding-bottom: 22px; border-bottom: 1px solid var(--border-subtle); text-align: center;">
      <h2 style="font-size: var(--fs-h2); font-weight: var(--fw-semibold); color: var(--text-heading); margin: 0;">
        Preguntas frecuentes
      </h2>
    </div>
    <div
      style="margin-top: 8px; display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 0 56px; align-items: start;"
    >
      {faqs.map((f) => <FaqItem question={f.q} answer={f.a} />)}
    </div>
  </div>
</section>
