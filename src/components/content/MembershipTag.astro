---
/* MembershipTag del design system: la tarjetita física de la membresía. */
import { GRAD, type ClaveMembresia } from '../../data/membresias';
import { isotipo } from '../../lib/imagenes';

interface Props {
  membership: ClaveMembresia;
  name: string;
  motto?: string;
  size?: 'sm' | 'md';
}

const { membership, name, motto, size = 'md' } = Astro.props;

const grad = GRAD[membership] ?? GRAD.anticipa;
const parts = String(name).trim().split(/\s+/);
const brand = parts.length > 1 ? parts[0] : 'ZK';
const label = parts.length > 1 ? parts.slice(1).join(' ') : name;

const dims =
  size === 'sm'
    ? { width: 190, radius: 20, pad: 20, nameSize: 21, mottoSize: 16, mottoGap: 20, logo: 34, top: 30 }
    : { width: 250, radius: 28, pad: 26, nameSize: 28, mottoSize: 21, mottoGap: 26, logo: 46, top: 40 };
---

<div
  class="zk-mtag"
  style={`position: relative; width: ${dims.width}px; aspect-ratio: 1 / 1.36; border-radius: ${dims.radius}px; background: ${grad}; color: #fff; padding: ${dims.pad}px; box-sizing: border-box; display: flex; flex-direction: column; font-family: var(--font-sans); overflow: hidden; box-shadow: 0 22px 44px -18px rgba(0,0,0,.4); flex-shrink: 0;`}
>
  <span
    aria-hidden="true"
    style={`position: absolute; top: ${dims.pad - 4}px; right: ${dims.pad - 4}px; width: ${dims.logo}px; height: ${dims.logo}px; border-radius: 50%; background: #fff; display: inline-flex; align-items: center; justify-content: center;`}
  >
    <img src={isotipo.src} alt="" style="width: 72%; height: 72%; object-fit: contain;" />
  </span>
  <div
    style={`margin-top: ${dims.top}px; font-size: ${dims.nameSize}px; font-weight: var(--fw-light); letter-spacing: .04em; line-height: 1.5; text-transform: uppercase;`}
  >
    <div>{brand}</div>
    <div>{label}</div>
  </div>
  {
    motto && (
      <div
        style={`margin-top: ${dims.mottoGap}px; font-size: ${dims.mottoSize}px; font-weight: var(--fw-light); letter-spacing: .04em; text-transform: uppercase; line-height: 1.5; opacity: .95; max-width: 86%;`}
      >
        {motto}
      </div>
    )
  }
  <svg
    viewBox="0 0 250 96"
    preserveAspectRatio="none"
    aria-hidden="true"
    style="position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 96px; opacity: .38;"
  >
    <path d="M40 92 C 130 58, 190 60, 262 20" fill="none" stroke="#fff" stroke-width="1.2"></path>
    <path d="M96 96 C 160 74, 205 74, 262 46" fill="none" stroke="#fff" stroke-width="1" opacity=".7"></path>
  </svg>
</div>
